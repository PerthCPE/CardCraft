// ============================================================================
// CardCraft Prisma Schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum ประเภทข้อผิดพลาด (Error Classification)
enum ErrorType {
  part_of_speech
  tense
  preposition
  vocabulary
  connector
  subject_verb_agreement
  pronoun
  listening_trap
  detail_miss
  other
}

// 1. User Model — ข้อมูลผู้เล่น (Hero Profile) และคะแนนประเมิน TOEIC ปัจจุบัน
model User {
  id                    String         @id @default(uuid())
  username              String         @unique @default(uuid())
  password              String         @default("8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918") // sha256 of '123456'
  email                 String?        @unique
  name                  String
  targetScore           Int            @default(700) // เป้าหมายหลักของโปรเจกต์คือ TOEIC 700+
  currentEstimatedScore Int            @default(0)   // คะแนนประเมินเริ่มต้น (0-990)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  cardProgresses        CardProgress[]
  examAttempts          ExamAttempt[]
  answerLogs            AnswerLog[]
  partSkillEstimates    PartSkillEstimate[]
}

// 2. Flashcard Model — การ์ดคำศัพท์ RPG (Spell Cards) สำหรับฝึกศัพท์ TOEIC 700+
model Flashcard {
  id             String         @id @default(uuid())
  word           String
  partOfSpeech   String         // เช่น "n.", "v.", "adj.", "adv."
  meaningTh      String         // ความหมายภาษาไทย
  exampleEn      String         // ประโยคตัวอย่างแนวข้อสอบ Business / TOEIC
  category       String         // เช่น "Contracts", "Marketing", "Finance", "Logistics"
  manaCost       Int            @default(2) // ระดับความยาก 1-5 (แสดงเป็น Mana Crystal บนการ์ด)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cardProgresses CardProgress[]
  questions      Question[]
  answerLogs     AnswerLog[]
}

// 3. CardProgress Model — บันทึกผลการปัดการ์ดและระบบ Spaced Repetition (Task B)
model CardProgress {
  id           String    @id @default(uuid())
  userId       String
  cardId       String
  isKnown      Boolean   @default(false) // ปัดขวา = true (Mastered), ปัดซ้าย = false (Still Learning)
  swipeCount   Int       @default(1)     // จำนวนครั้งที่ปัดการ์ดใบนี้แล้ว
  dueAt        DateTime  @default(now()) // วันเวลาที่ครบกำหนดทบทวน (Spaced Repetition)
  intervalDays Float     @default(1.0)   // ระยะห่างวันในการทบทวนรอบถัดไป
  easeFactor   Float     @default(2.5)   // สัมประสิทธิ์ความยากง่าย (SM-2 Default: 2.5)
  correctCount Int       @default(0)     // จำนวนครั้งที่ปัดขวา/จำได้
  wrongCount   Int       @default(0)     // จำนวนครั้งที่ปัดซ้าย/ตอบผิด
  lastWrongAt  DateTime?                 // วันเวลาล่าสุดที่ตอบผิดหรือปัดซ้าย
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueAt])
  @@index([userId, isKnown])
  @@index([userId, wrongCount])
}

// 4. Question Model — คลังข้อสอบ TOEIC ทั้ง Listening และ Reading
model Question {
  id            String      @id @default(uuid())
  section       String      // "LISTENING" | "READING"
  part          Int         // 1, 2, 5, หรือ 7
  audioUrl      String?     // Nullable: ใช้สำหรับพาร์ท Listening (Part 1, 2)
  imageUrl      String?     // Nullable: ใช้สำหรับรูปภาพใน Part 1 Photographs
  passageText   String?     // Nullable: ใช้สำหรับบทความ/อีเมลธุรกิจใน Part 7 Reading Comprehension
  questionText  String      // โจทย์คำถาม (หรือ Audio Transcript สำหรับเฉลย Part 1/2)
  optionA       String
  optionB       String
  optionC       String
  optionD       String?     // Nullable: เพราะ TOEIC Part 2 มีแค่ตัวเลือก A, B, C
  correctOption String      // "A" | "B" | "C" | "D"
  explanationTh String      // เฉลยและคำอธิบายไวยากรณ์/เทคนิคการตัดช้อยส์ภาษาไทยอย่างละเอียด
  tag           String      // เช่น "Part 5 - Word Family", "Part 7 - Business Email"
  errorTag      ErrorType?  // จัดหมวดหมู่จุดผิดพลาดสำหรับการวิเคราะห์ Weakness Analytics
  vocabId       String?     // เชื่อมโยงคำศัพท์กับตาราง Flashcard เพื่อส่งเข้าคิวทบทวนเมื่อทำผิด
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  vocab         Flashcard?  @relation(fields: [vocabId], references: [id], onDelete: SetNull)
  answerLogs    AnswerLog[]

  @@index([errorTag])
  @@index([vocabId])
}

// 5. ExamAttempt Model — ประวัติการทำข้อสอบ Boss Battle (Mini Mock) และ Full Mock
model ExamAttempt {
  id               String      @id @default(uuid())
  userId           String
  mode             String      // "MINI_MOCK" | "FULL_MOCK" | "FULL_LISTENING" | "FULL_READING" | "READING_DRILL" | "LISTENING_DRILL"
  listeningCorrect Int
  readingCorrect   Int
  estimatedScore   Int         // คะแนนเทียบสเกล TOEIC (10 - 990)
  scoreMin         Int?        // ช่วงคะแนนต่ำสุด เช่น 700
  scoreMax         Int?        // ช่วงคะแนนสูงสุด เช่น 750
  listeningScore   Int?        // คะแนนส่วน Listening (5 - 495)
  readingScore     Int?        // คะแนนส่วน Reading (5 - 495)
  unlockedTier     Int         // ระดับคลาสตัวละครที่ปลดล็อกได้ (Tier 1 - 7)
  isPassedTarget   Boolean     // true เมื่อ estimatedScore >= targetScore
  timeSpentSeconds Int         // เวลาที่ใช้ทำข้อสอบ (วินาที)
  createdAt        DateTime    @default(now())

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerLogs       AnswerLog[]
}

// 6. AnswerLog Model — บันทึกประวัติการตอบคำถามรายข้อแบบละเอียด
model AnswerLog {
  id             String       @id @default(uuid())
  userId         String
  attemptId      String?      // เชื่อมโยงกับ ExamAttempt (Nullable หากตอบใน Practice Drill รายข้อ)
  questionId     String
  part           Int
  mode           String       // โหมดที่ตอบคำถาม
  selectedOption String       // ตัวเลือกที่ผู้ใช้ตอบ "A" | "B" | "C" | "D"
  correctOption  String       // เฉลยที่ถูกต้อง "A" | "B" | "C" | "D"
  isCorrect      Boolean      // true เมื่อตอบถูก
  errorType      ErrorType?   // ประเภทจุดบกพร่องกรณีตอบผิด
  vocabId        String?      // คำศัพท์ที่เกี่ยวข้อง (ถ้ามี)
  timeSpentMs    Int          @default(0) // เวลาที่ใช้ตอบข้อนี้ (มิลลิวินาที)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt        ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  vocab          Flashcard?   @relation(fields: [vocabId], references: [id], onDelete: SetNull)

  @@index([userId, isCorrect])
  @@index([userId, errorType])
  @@index([userId, part])
  @@index([userId, createdAt])
}

// 7. PartSkillEstimate Model — บันทึกผลการประเมินคะแนนแยก 7 พาร์ทจากการฝึกซ้อมรายพาร์ท (/practice)
// ไม่กระทบ official currentEstimatedScore หรือ Character Evolution Tier (Tiers 1-7)
model PartSkillEstimate {
  id             String    @id @default(uuid())
  userId         String
  part           Int       // 1 - 7
  accuracy       Float     // ค่าความแม่นยำ 0.0 - 1.0
  totalQuestions Int       // จำนวนข้อที่ทำในการฝึกรอบล่าสุด
  correctAnswers Int       // จำนวนข้อที่ตอบถูก
  estimatedScore Int       // คะแนนคาดการณ์เฉพาะพาร์ทนี้ตามสัดส่วนคะแนนเต็มของพาร์ท
  maxPartScore   Int       // คะแนนเต็มของพาร์ทนั้นๆ (P1=30, P2=125, P3=190, P4=150, P5=150, P6=80, P7=265)
  supportiveTier Int       // ช่วงระดับกำลังใจ 1 - 5 (Seedling Stage -> Grand Master)
  lastPracticedAt DateTime @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, part])
  @@index([userId])
}
